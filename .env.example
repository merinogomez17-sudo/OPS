# Supabase (proyecto "Propinas app")
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo servidor. Supabase > Project Settings > API Keys > secret / service_role. Necesaria para Stripe.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública que se graba en las tarjetas NFC. En desarrollo: la IP de tu PC en la red WiFi.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (modo prueba). Si están vacías, la app funciona en MODO DEMO (sin cobros reales).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
